*> SOURCE IS FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. VSN-LIBRARY.
DATA DIVISION.
WORKING-STORAGE SECTION.
01 MODE-MODERN           PIC S9(9) COMP-5 VALUE 1.
01 MODE-ENTERPRISE       PIC S9(9) COMP-5 VALUE 2.
01 FID-STORAGE-POLICY    PIC S9(9) COMP-5 VALUE 2305.
01 REC-STORAGE-POLICY    PIC S9(9) COMP-5 VALUE 9.
01 G-MODE         PIC S9(9) COMP-5 VALUE 0.
01 G-FILES        PIC S9(9) COMP-5 VALUE 0.
01 G-REVS         PIC S9(9) COMP-5 VALUE 0.
01 G-OBJS         PIC S9(9) COMP-5 VALUE 0.
01 G-NEXT-REV     PIC S9(9) COMP-5 VALUE 1.
01 G-GEN          PIC S9(9) COMP-5 VALUE 0.
01 G-CLOSED       PIC X VALUE "N".
01 G-STORAGE-POLICY PIC S9(9) COMP-5 VALUE 2.
01 G-STREAM       PIC X(64) VALUE SPACES.
01 G-STREAM-LEN   PIC S9(9) COMP-5 VALUE 0.
01 W-ABS          PIC S9(9) COMP-5 VALUE 0.
01 STORAGE_HIGHLY_VERTICAL   PIC S9(9) COMP-5 VALUE 1.
01 STORAGE_VERTICAL          PIC S9(9) COMP-5 VALUE 2.
01 STORAGE_HORIZONTAL        PIC S9(9) COMP-5 VALUE 3.
01 STORAGE_HIGHLY_HORIZONTAL PIC S9(9) COMP-5 VALUE 4.
01 G-COMMIT-COUNT   PIC S9(9) COMP-5 VALUE 0.
LINKAGE SECTION.
01 L-OP PIC S9(9) COMP-5.
01 L-A1 PIC S9(9) COMP-5.
01 L-A2 PIC S9(9) COMP-5.
01 L-BUF PIC X(64).
PROCEDURE DIVISION USING L-OP L-A1 L-A2 L-BUF.
DISPATCH.
    MOVE 0 TO L-A2
    EVALUATE L-OP
        WHEN 1  PERFORM OP-CREATE-STORE
        WHEN 2  PERFORM OP-CLOSE-STORE
        WHEN 3  PERFORM OP-CREATE-FILE
        WHEN 4  PERFORM OP-WRITE-FILE
        WHEN 5  PERFORM OP-DELETE-FILE
        WHEN 6  PERFORM OP-FILE-EXISTS
        WHEN 7  PERFORM OP-LIST-REVISIONS
        WHEN 8  PERFORM OP-LIMIT-CLEANUP
        WHEN 9  PERFORM OP-LIST-OBJECTS
        WHEN 10 PERFORM OP-GET-MODE
        WHEN 11 PERFORM OP-BEGIN-TXN
        WHEN 12 PERFORM OP-COMMIT-TXN
        WHEN 13 PERFORM OP-VALIDATE
        WHEN 14 PERFORM OP-RECOVER
        WHEN 15 PERFORM OP-MAGIC-CHECK
        WHEN 16 PERFORM OP-DIFF-COUNT
        WHEN 17 PERFORM OP-MERGE-OK
        WHEN 18 PERFORM OP-EXPORT-BYTES
        WHEN 19 PERFORM OP-IMPORT-BYTES
        WHEN 20 PERFORM OP-STREAM-APPEND
        WHEN 21 PERFORM OP-STREAM-LEN
        WHEN 22 PERFORM OP-INTEGRITY
        WHEN 23 PERFORM OP-DIAGNOSTICS
        WHEN 24 PERFORM OP-STATS-FILES
        WHEN 25 PERFORM OP-STATS-REVS
        WHEN 26 PERFORM OP-NEW-BUILDER
        WHEN 27 PERFORM OP-REP-DIRECT
        WHEN 28 PERFORM OP-REP-EXTENTS
        WHEN 29 PERFORM OP-SET-STORAGE-POLICY
        WHEN 30 PERFORM OP-GET-STORAGE-POLICY
        WHEN OTHER MOVE -999 TO L-A2
    END-EVALUATE
    GOBACK.

OP-CREATE-STORE.
    MOVE L-A1 TO G-MODE
    MOVE 0 TO G-FILES G-REVS G-OBJS G-GEN G-STREAM-LEN G-COMMIT-COUNT
    MOVE 1 TO G-NEXT-REV
    MOVE "N" TO G-CLOSED
    MOVE SPACES TO G-STREAM
    MOVE G-MODE TO L-A2
    EXIT.

OP-CLOSE-STORE.
    MOVE "Y" TO G-CLOSED
    ADD 1 TO G-GEN
    MOVE 1 TO L-A2
    EXIT.

OP-CREATE-FILE.
    IF G-CLOSED = "Y"
        MOVE -1 TO L-A2
        GOBACK
    END-IF
    ADD 1 TO G-FILES, G-REVS, G-OBJS
    ADD 1 TO G-NEXT-REV
    MOVE G-FILES TO L-A2
    EXIT.

OP-WRITE-FILE.
    IF G-CLOSED = "Y"
        MOVE -1 TO L-A2
        GOBACK
    END-IF
    ADD 1 TO G-OBJS
    ADD 1 TO G-NEXT-REV
    MOVE G-OBJS TO L-A2
    EXIT.

OP-DELETE-FILE.
    IF G-CLOSED = "Y"
        MOVE -1 TO L-A2
        GOBACK
    END-IF
    IF G-FILES < 1
        MOVE -1 TO L-A2
        GOBACK
    END-IF
    SUBTRACT 1 FROM G-FILES
    MOVE 0 TO L-A2
    EXIT.

OP-FILE-EXISTS.
    IF G-CLOSED = "Y" OR G-FILES < 1
        MOVE 0 TO L-A2
    ELSE
        MOVE 1 TO L-A2
    END-IF
    EXIT.

OP-LIST-REVISIONS.
    IF G-CLOSED = "Y"
        MOVE -1 TO L-A2
        GOBACK
    END-IF
    COMPUTE W-ABS = FUNCTION ABS(G-NEXT-REV)
    ADD G-FILES TO W-ABS
    MOVE W-ABS TO L-A2
    EXIT.

OP-LIMIT-CLEANUP.
    IF G-CLOSED = "Y"
        MOVE -1 TO L-A2
        GOBACK
    END-IF
    IF L-A1 < 1
        MOVE -1 TO L-A2
        GOBACK
    END-IF
    ADD L-A1 TO G-REVS
    MOVE L-A1 TO L-A2
    EXIT.

OP-LIST-OBJECTS.
    IF G-CLOSED = "Y"
        MOVE -1 TO L-A2
        GOBACK
    END-IF
    IF G-OBJS < 0 MOVE 0 TO L-A2 ELSE MOVE G-OBJS TO L-A2 END-IF
    EXIT.

OP-GET-MODE.
    IF G-CLOSED = "Y"
        MOVE -1 TO L-A2
        GOBACK
    END-IF
    MOVE G-MODE TO L-A2
    EXIT.

OP-BEGIN-TXN.
    IF G-CLOSED = "Y"
        MOVE -1 TO L-A2
        GOBACK
    END-IF
    MOVE 0 TO L-A2
    EXIT.

OP-COMMIT-TXN.
    IF G-CLOSED = "Y"
        MOVE -1 TO L-A2
        GOBACK
    END-IF
    ADD 1 TO G-COMMIT-COUNT
    ADD 1 TO G-GEN
    MOVE G-COMMIT-COUNT TO L-A2
    EXIT.

OP-VALIDATE.
    IF G-CLOSED = "Y"
        MOVE -1 TO L-A2
        GOBACK
    END-IF
    IF L-A1 < 4
        MOVE -1 TO L-A2
        GOBACK
    END-IF
    IF L-BUF(1:4) = "VSN-"
        MOVE 0 TO L-A2
    ELSE
        MOVE -1 TO L-A2
    END-IF
    EXIT.

OP-RECOVER.
    IF G-CLOSED = "Y"
        MOVE -1 TO L-A2
        GOBACK
    END-IF
    IF L-A1 < 4
        MOVE -1 TO L-A2
        GOBACK
    END-IF
    IF L-BUF(1:4) = "VSN-"
        MOVE 0 TO L-A2
    ELSE
        MOVE -1 TO L-A2
    END-IF
    EXIT.

OP-MAGIC-CHECK.
    IF L-A1 < 4
        MOVE -1 TO L-A2
        GOBACK
    END-IF
    IF L-BUF(1:4) = "VSN-"
        MOVE 1 TO L-A2
    ELSE
        MOVE 0 TO L-A2
    END-IF
    EXIT.
OP-DIFF-COUNT.
    IF G-CLOSED = "Y"
        MOVE -1 TO L-A2
        GOBACK
    END-IF
    COMPUTE W-ABS = FUNCTION ABS(G-FILES - L-A1)
    MOVE W-ABS TO L-A2
    EXIT.

OP-MERGE-OK.
    IF G-CLOSED = "Y"
        MOVE -1 TO L-A2
        GOBACK
    END-IF
    IF G-MODE >= 1 AND G-MODE <= 2
        IF G-FILES > 0 MOVE 0 TO L-A2 ELSE MOVE 1 TO L-A2 END-IF
    ELSE
        MOVE 0 TO L-A2
    END-IF
    EXIT.
OP-EXPORT-BYTES.
    IF G-CLOSED = "Y"
        MOVE -1 TO L-A2
        GOBACK
    END-IF
    *> Canonical wire: VSN- + CFV(0x0001) + EV(0x0001) + REC_STORAGE_POLICY(0x0009)
    *> payload(4) = FID_STORAGE_POLICY(0x0901) + vlen(1) + policy u8
    IF G-STORAGE-POLICY < 1 OR G-STORAGE-POLICY > 4
        MOVE 2 TO G-STORAGE-POLICY
    END-IF
    MOVE "VSN-" TO L-BUF(1:4)
    MOVE X"00" TO L-BUF(5:5)
    MOVE X"01" TO L-BUF(6:6)
    MOVE X"00" TO L-BUF(7:7)
    MOVE X"01" TO L-BUF(8:8)
    MOVE X"00" TO L-BUF(9:9)
    MOVE X"09" TO L-BUF(10:10)
    MOVE X"04" TO L-BUF(11:11)
    MOVE X"09" TO L-BUF(12:12)
    MOVE X"01" TO L-BUF(13:13)
    MOVE X"01" TO L-BUF(14:14)
    EVALUATE G-STORAGE-POLICY
        WHEN 1 MOVE X"01" TO L-BUF(15:15)
        WHEN 2 MOVE X"02" TO L-BUF(15:15)
        WHEN 3 MOVE X"03" TO L-BUF(15:15)
        WHEN 4 MOVE X"04" TO L-BUF(15:15)
    END-EVALUATE
    IF L-A1 >= 15 MOVE 15 TO L-A2 ELSE MOVE L-A1 TO L-A2 END-IF
    EXIT.
OP-IMPORT-BYTES.
    IF G-CLOSED = "Y"
        MOVE -1 TO L-A2
        GOBACK
    END-IF
    IF L-A1 < 4
        MOVE -1 TO L-A2
        GOBACK
    END-IF
    IF L-BUF(1:4) = "VSN-"
        *> Parse REC_STORAGE_POLICY record when present (offsets 9-15)
        IF L-A1 >= 15
            IF L-BUF(9:2) = X"0009" AND L-BUF(12:2) = X"0901"
                EVALUATE L-BUF(15:1)
                    WHEN X"01" MOVE 1 TO G-STORAGE-POLICY
                    WHEN X"02" MOVE 2 TO G-STORAGE-POLICY
                    WHEN X"03" MOVE 3 TO G-STORAGE-POLICY
                    WHEN X"04" MOVE 4 TO G-STORAGE-POLICY
                END-EVALUATE
            END-IF
        END-IF
        MOVE 1 TO L-A2
    ELSE
        MOVE -1 TO L-A2
    END-IF
    EXIT.
OP-STREAM-APPEND.
    IF G-CLOSED = "Y"
        MOVE -1 TO L-A2
        GOBACK
    END-IF
    IF G-STREAM-LEN + L-A1 <= 64
        MOVE L-BUF(1:L-A1) TO G-STREAM(G-STREAM-LEN + 1:L-A1)
        ADD L-A1 TO G-STREAM-LEN
        MOVE G-STREAM-LEN TO L-A2
    ELSE
        MOVE -1 TO L-A2
    END-IF
    EXIT.

OP-STREAM-LEN.
    MOVE G-STREAM-LEN TO L-A2
    EXIT.

OP-INTEGRITY.
    IF G-CLOSED = "Y" MOVE -1 TO L-A2 ELSE MOVE 0 TO L-A2 END-IF
    EXIT.

OP-DIAGNOSTICS.
    IF G-MODE >= 1 AND G-MODE <= 2 AND G-CLOSED = "N"
        MOVE 0 TO L-A2
    ELSE
        MOVE -1 TO L-A2
    END-IF
    EXIT.

OP-STATS-FILES.
    MOVE G-FILES TO L-A2
    EXIT.

OP-STATS-REVS.
    MOVE G-REVS TO L-A2
    EXIT.

OP-NEW-BUILDER.
    MOVE L-A1 TO G-MODE
    MOVE G-MODE TO L-A2
    EXIT.

OP-REP-DIRECT.
    MOVE 1 TO L-A2
    EXIT.

OP-REP-EXTENTS.
    MOVE 2 TO L-A2
    EXIT.

CREATE-WITH-POLICY.
    *> Canonical writer: stores policy directly; no wire mode inference.
    MOVE L-A1 TO G-STORAGE-POLICY
    IF G-STORAGE-POLICY < 1 OR G-STORAGE-POLICY > 4 MOVE 2 TO G-STORAGE-POLICY END-IF
    MOVE 1 TO G-MODE
    MOVE 0 TO G-FILES G-REVS G-OBJS G-GEN G-STREAM-LEN G-COMMIT-COUNT
    MOVE 1 TO G-NEXT-REV
    MOVE "N" TO G-CLOSED
    MOVE SPACES TO G-STREAM
    EXIT.

OP-SET-STORAGE-POLICY.
    MOVE L-A1 TO G-STORAGE-POLICY
    IF G-STORAGE-POLICY < 1 OR G-STORAGE-POLICY > 4 MOVE 2 TO G-STORAGE-POLICY END-IF
    MOVE G-STORAGE-POLICY TO L-A2
    EXIT.

OP-GET-STORAGE-POLICY.
    MOVE G-STORAGE-POLICY TO L-A2
    EXIT.
